<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="/Users/sarahli/Downloads/chinook.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="3287"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="0" parent="0"/><expanded_item id="9" parent="0"/><expanded_item id="10" parent="0"/><expanded_item id="11" parent="0"/><expanded_item id="12" parent="0"/><expanded_item id="13" parent="0"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Music_Video" custom_title="0" dock_id="4" table="4,11:mainMusic_Video"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Music_Video" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="64"/><column index="2" value="103"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- query 1: create Music_Video TABLE

DROP TABLE IF EXISTS Music_Video;

CREATE TABLE Music_Video(
	track_id INTEGER PRIMARY KEY,
	video_director TEXT,
	FOREIGN KEY (track_id) REFERENCES tracks(TrackId)
	);

-- query 2: insert 10 videos
INSERT INTO Music_Video (track_id, video_director) VALUES
(1, &quot;John Williams&quot;),
(2, &quot;Jerry Goldsmith&quot;),
(3, &quot;Ennio Morricone&quot;),
(4, &quot;Hans Zimmer&quot;),
(5, &quot;James Newton Howard&quot;),
(6, &quot;Alan Silvestri&quot;),
(7, &quot;James Horner&quot;),
(8, &quot;Thomas Newman&quot;),
(9, &quot;John Barry&quot;),
(10, &quot;Vangelis&quot;);

-- query 3: insert another video for the track Voodoo
INSERT INTO Music_Video (track_id, video_director)
SELECT TrackId, &quot;Mac Rebennack&quot;
FROM tracks
WHERE Name LIKE &quot;%Voodoo&quot;
LIMIT 1;

-- query 4: lists all tracks with ' in name
SELECT TrackId, name
FROM tracks
WHERE Name LIKE &quot;%á%&quot;
	OR Name LIKE &quot;%é%&quot; 
	OR Name LIKE &quot;%í%&quot;
	OR Name LIKE &quot;%ó%&quot;
	OR Name LIKE &quot;%ú%&quot;
	OR Name LIKE &quot;%Á%&quot;
	OR Name LIKE &quot;%É%&quot;
	OR Name LIKE &quot;%Í%&quot;
	OR Name LIKE &quot;%Ó%&quot;
	OR Name LIKE &quot;%Ú%&quot;;
	
-- query 5: joins albums with artists 
SELECT
	a.Title AS AlbumTitle,
	ar.Name AS ArtistName
FROM albums a
INNER JOIN artists ar ON a.ArtistId = ar.ArtistId
ORDER BY ar.Name
LIMIT 50;

-- query 6: uses GROUP statement and at least two tables.
SELECT 
	ar.Name AS ArtistName,
	COUNT(a.AlbumId) AS NumberOfAlbums
FROM artists ar
INNER JOIN albums a ON ar.ArtistID = a.ArtistId 
GROUP BY ar.ArtistId
ORDER BY NumberOfAlbums DESC
LIMIT 20;

-- query 7: lists all customers that listen to longer-than-average tracks, where tracks &lt; 15mins
SELECT 
    c.FirstName || ' ' || c.LastName AS CustomerName,
    ROUND(AVG(t.Milliseconds / 60000.0), 2) AS AvgTrackMinutes
FROM customers c
INNER JOIN invoices i ON c.CustomerId = i.CustomerId
INNER JOIN invoice_items ii ON i.InvoiceId = ii.InvoiceId
INNER JOIN tracks t ON ii.TrackId = t.TrackId
WHERE t.Milliseconds &lt; 900000
GROUP BY c.CustomerId
HAVING AVG(t.Milliseconds) &gt; (
    SELECT AVG(Milliseconds)
    FROM tracks
    WHERE Milliseconds &lt; 900000
)
ORDER BY AvgTrackMinutes DESC;

-- query 8: lists all tracks not in top 5 genres with longer duration
SELECT 
    t.TrackId,
    t.Name AS TrackName,
    g.Name AS Genre,
    ROUND(t.Milliseconds / 60000.0, 2) AS Minutes
FROM tracks t
INNER JOIN genres g ON t.GenreId = g.GenreId
WHERE t.GenreId NOT IN (
    SELECT g2.GenreId
    FROM genres g2
    INNER JOIN tracks t2 ON g2.GenreId = t2.GenreId
    GROUP BY g2.GenreId
    ORDER BY SUM(t2.Milliseconds) DESC
    LIMIT 5
)
ORDER BY t.Milliseconds DESC
LIMIT 50;</sql><current_tab id="0"/></tab_sql></sqlb_project>
